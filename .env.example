# Exact browser origin, no trailing slash or path.
PUBLIC_ORIGIN=http://localhost:8080
APP_PORT=8080
MAILPIT_PORT=8025
# Local capture is not external email. Use compose.smtp.yaml for SMTP.
EMAIL_MODE=capture
# SMTP override only (see docs/smtp.md; never put passwords here):
# SMTP_HOST=smtp.provider.example
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_FROM=invitations@your-domain.example
# HTTPS override only:
# COMMONFIELD_HOST=board.example.com
# ACME_EMAIL=admin@example.com
